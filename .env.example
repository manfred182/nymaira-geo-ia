# GEOIA - Configuración
# Copia este archivo como .env y edítalo

# === PROVEEDOR DE IA ===
# Déjalo vacío para usar modelos locales open-source (recomendado)
# O configura una API key de OpenAI para usar GPT:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === MODELO LOCAL ===
# Déjalo vacío para auto-detectar en models/llm/
# Si usas Ollama, pon el nombre del modelo (ej: qwen2.5:0.5b, llama3.2:1b)
LLM_MODEL=
# Contexto máximo en tokens (menos = más rápido, más = respuestas largas)
LLM_N_CTX=2048

# === MODO DESARROLLO ===
# true  = recarga automática al cambiar código, más logs
# false = modo producción (más rápido)
DEBUG=false
